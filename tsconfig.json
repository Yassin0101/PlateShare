{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "expo-router/entry": [
        "./node_modules/expo-router/entry"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/(tabs)/home.jsx",
    "app/(tabs)/home.jsx",
    "app/(tabs)/_layout.jsx",
    "app/_layout.jsx",
    "app/+not-found.jsx",
    "nativewind-env.d.ts"
  ]
}